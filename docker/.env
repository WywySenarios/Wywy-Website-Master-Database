# Compose variable substitution for CI.
# Auto-loaded because project directory resolves to docker/.
# These are NOT used at runtime — docker-compose.test.yml overrides
# env_file, volumes, and secrets to use local fixtures only.
# Relative to docker/ (project directory), resolves to repo root's config/ci.
UNIVERSAL_CONFIG_DIR=../config/ci
SECRETS_DIR=../config/ci
DATA_DIR=../config/ci
USER_ID=25231
DATABASE_PASSWORD=postgres-password-test
DATABASE_USERNAME=postgres
DATABASE_PORT=5432
DATABASE_MIGRATOR_USERNAME=wywy_migrator
DATABASE_MIGRATOR_PASSWORD=migrator-password-test
